{
  "name": "sengoku-life",
  "version": "0.1.0",
  "private": true,
  "description": "《战国浮生录》Playable Demo —— 日本战国穿越人生模拟 RPG",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && npx serve dist",
    "test": "node --import tsx --test tests/engine.test.ts tests/audio.test.ts tests/v03.test.ts tests/v04.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "balance": "tsx scripts/balance.ts",
    "playthrough": "tsx scripts/playthrough.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
